local customSkyTexture = "rbxassetid://91562807408462"
local blackColor, whiteColor = Color3.fromRGB(0, 0, 0), Color3.fromRGB(255, 255, 255)

local function applySkinToObject(obj, targetColor)
   if obj.Name == "StagePart" and obj.Parent and obj.Parent.Name == "VArenaDimension" then return end
   if obj:IsA("Sky") then
      obj.SkyboxBk, obj.SkyboxDn, obj.SkyboxFt, obj.SkyboxLf, obj.SkyboxRt, obj.SkyboxUp = customSkyTexture, customSkyTexture, customSkyTexture, customSkyTexture, customSkyTexture, customSkyTexture
   elseif obj:IsA("Atmosphere") then
      obj.Decay = (targetColor == blackColor) and whiteColor or targetColor
   elseif obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") then
      obj.Color = ColorSequence.new(targetColor)
   elseif obj:IsA("Light") then
      obj.Color = targetColor
   elseif obj:IsA("Highlight") then
      obj.FillColor, obj.OutlineColor = targetColor, targetColor
   elseif obj:IsA("BasePart") then
      obj.Color = targetColor
   end
end

local portalConn, wsPortalConn
local function ApplyPortalSkinLogic()
   local targetColor = ColorMap[tostring(Config.PortalSkin):upper()]
   if not targetColor then return end

   task.spawn(function()
      if portalConn then portalConn:Disconnect() portalConn = nil end
      if wsPortalConn then wsPortalConn:Disconnect() wsPortalConn = nil end

      local fx = ReplicatedStorage:WaitForChild("FX", 10)
      local portalFX = fx and (fx:FindFirstChild("PortalEffects") or fx:WaitForChild("PortalEffects", 10))

      if portalFX then
         for _, v in ipairs(portalFX:GetDescendants()) do applySkinToObject(v, targetColor) end
         portalConn = portalFX.DescendantAdded:Connect(function(child)
            local cur = ColorMap[tostring(Config.PortalSkin):upper()]
            if cur then applySkinToObject(child, cur) end
         end)
      end

      for _, obj in ipairs(Workspace:GetDescendants()) do
         if string.find(string.lower(obj.Name), "portal") then
            applySkinToObject(obj, targetColor)
            for _, c in ipairs(obj:GetDescendants()) do applySkinToObject(c, targetColor) end
         end
      end

      wsPortalConn = Workspace.DescendantAdded:Connect(function(child)
         if string.find(string.lower(child.Name), "portal") or (child.Parent and string.find(string.lower(child.Parent.Name), "portal")) then
            local cur = ColorMap[tostring(Config.PortalSkin):upper()]
            if cur then applySkinToObject(child, cur) end
         end
      end)
   end)
end

