local function removeCafeObject(path)
   local current = Workspace
   for _, name in ipairs(path) do
      current = current:FindFirstChild(name)
      if not current then return end
   end
   current:Destroy()
end

local function moveCafeNPC(npc, targetPos)
   if npc:IsA("Model") then npc:PivotTo(CFrame.new(targetPos))
   elseif npc:IsA("BasePart") then npc.Position = targetPos end
   local upper = npc:FindFirstChild("UpperTorso")
   if upper and upper:IsA("BasePart") then upper.Position = targetPos end
   local root = npc:FindFirstChild("HumanoidRootPart")
   if root and root:IsA("BasePart") then root.Position = targetPos end
end

local function ApplyCustomCafeLogic()
   if isCustomCafeApplied then return end
   isCustomCafeApplied = true

   local minPos, maxPos = Vector3.new(-466, 69, 200), Vector3.new(-310, 69, 393)
   local part = Workspace:FindFirstChild("MainCafePart") or Instance.new("Part")
   part.Name, part.Size, part.Position = "MainCafePart", Vector3.new(math.abs(maxPos.X - minPos.X), 1, math.abs(maxPos.Z - minPos.Z)), (minPos + maxPos) / 2
   part.Color, part.Material, part.Anchored, part.Parent = Color3.fromRGB(100, 100, 100), Enum.Material.SmoothPlastic, true, Workspace

   for _, path in ipairs(cafeTargets) do removeCafeObject(path) end
   local dressrosa = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Dressrosa")
   if dressrosa then
      for _, child in ipairs(dressrosa:GetChildren()) do
         for _, tName in ipairs(cafeBulkTargets) do
            if child.Name == tName then child:Destroy() break end
         end
      end
      local model = dressrosa:FindFirstChild("Model")
      if model then
         for _, child in ipairs(model:GetChildren()) do
            if child.Name == "Tree" then child:Destroy() end
         end
      end
   end

   Workspace.DescendantAdded:Connect(function(descendant)
      if not Config.CustomCafeEnabled then return end
      for _, path in ipairs(cafeTargets) do
         if descendant.Name == path[#path] then task.defer(function() removeCafeObject(path) end) end
      end
      for _, tName in ipairs(cafeBulkTargets) do
         if descendant.Name == tName and dressrosa and descendant:IsDescendantOf(dressrosa) then descendant:Destroy() end
      end
      if descendant.Name == "Tree" and descendant:IsDescendantOf(Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Dressrosa") and Workspace.Map.Dressrosa:FindFirstChild("Model")) then
         descendant:Destroy()
      end
   end)

   task.spawn(function()
      while task.wait(0.5) do
         if not Config.CustomCafeEnabled then break end
         local npcs = Workspace:FindFirstChild("NPCs")
         if npcs then
            for _, nData in ipairs(cafeNpcList) do
               local npc = npcs:FindFirstChild(nData.name)
               if npc then
                  local currentPos = npc:IsA("Model") and npc:GetPivot().Position or (npc:IsA("BasePart") and npc.Position)
                  if currentPos and (currentPos - nData.pos).Magnitude > 5 then
                     moveCafeNPC(npc, nData.pos)
                  end
               end
            end
         end
      end
   end)
end

local defaultConfig = "Dark Combo = False, G\nSuper Jump = False, G\nYama Bug = False, G\nGuitar Bug = False\nGodhuman Bug = False, G\nSanguine Bug = False, G\nPortal Skin = Default\nCustom Cafe = False"
local lastPortalSkin = nil

local function ReadTxtConfigs()
   pcall(function()
      if not isfolder(ConfigFolder) and makefolder then makefolder(ConfigFolder) end
      if not isfile(ConfigFile) and writefile then writefile(ConfigFile, defaultConfig) end
      if isfile(ConfigFile) and readfile then
         for line in readfile(ConfigFile):gmatch("[^\r\n]+") do
            local name, content = line:match("^([^=]+)=%s*(.-)%s*$")
            if name and content then
               name = name:match("^%s*(.-)%s*$")
               local enStr, keyStr = content:match("^([^,]+),%s*([^,]+)")
               local isEn = enStr and (enStr:match("^%s*(.-)%s*$"):lower() == "true") or (content:match("^%s*(.-)%s*$"):lower() == "true")
               local key = keyStr and Enum.KeyCode[keyStr:match("^%s*(.-)%s*$"):upper()]

               if name == "Dark Combo" then Config.DarkComboEnabled = isEn if key then Config.DarkComboKey = key end
               elseif name == "Super Jump" then Config.SuperJumpEnabled = isEn if key then Config.SuperJumpKey = key end
               elseif name == "Yama Bug" then Config.YamaBugEnabled = isEn if key then Config.YamaBugKey = key end
               elseif name == "Guitar Bug" then Config.GuitarBugEnabled = isEn
               elseif name == "Godhuman Bug" then Config.GodhumanBugEnabled = isEn if key then Config.GodhumanBugKey = key end
               elseif name == "Sanguine Bug" then Config.SanguineBugEnabled = isEn if key then Config.SanguineBugKey = key end
               elseif name == "Portal Skin" then
                  Config.PortalSkin = content:match("^%s*(.-)%s*$")
                  if Config.PortalSkin ~= lastPortalSkin then lastPortalSkin = Config.PortalSkin ApplyPortalSkinLogic() end
               elseif name == "Custom Cafe" then
                  Config.CustomCafeEnabled = isEn
                  if isEn then ApplyCustomCafeLogic() end
               end
            end
         end
      end
   end)
end

ReadTxtConfigs()
task.spawn(function()
