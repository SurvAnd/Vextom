end)

local function CheckToolTip(tool, wType)
   if not tool or not tool:IsA("Tool") then return false end
   local tt = tool.ToolTip
   return (wType == "Melee" and tt == "Melee") or (wType == "Blox Fruit" and (tt == "Blox Fruit" or string.find(tool.Name, "Fruit"))) or (wType == "Sword" and tt == "Sword") or (wType == "Gun" and tt == "Gun")
end

local function GetEquippedToolByName(kw)
   local char = LocalPlayer.Character
   if not char then return nil end
   local eq = char:FindFirstChildOfClass("Tool")
   if eq and string.find(string.lower(eq.Name), string.lower(kw)) then
      return eq
   end
   return nil
end

local function FindTool(kw, wType)
   local char = LocalPlayer.Character
   if not char then return nil end
   kw = string.lower(kw)
   local eq = char:FindFirstChildOfClass("Tool")
   if eq and string.find(string.lower(eq.Name), kw) and (not wType or CheckToolTip(eq, wType)) then return eq end
   local bp = LocalPlayer:FindFirstChild("Backpack")
   if bp then
      for _, t in ipairs(bp:GetChildren()) do
         if t:IsA("Tool") and string.find(string.lower(t.Name), kw) and (not wType or CheckToolTip(t, wType)) then return t end
      end
   end
   return nil
end

local function EquipWeapon(wType)
   local char = LocalPlayer.Character
   local hum = char and char:FindFirstChildOfClass("Humanoid")
   if not hum then return end
   local tool = FindTool("", wType)
   if tool then hum:EquipTool(tool) end
end

local function CastSkill(keyStr, hold)
   local k = Enum.KeyCode[tostring(keyStr):upper()]
   if k then
      VirtualInputManager:SendKeyEvent(true, k, false, game)
      task.wait(hold and hold > 0 and hold or 0.01)
      VirtualInputManager:SendKeyEvent(false, k, false, game)
   end
end

local activeCombos = {}
local function RunSequence(cName, seq)
   if activeCombos[cName] then return end
   if cName == "DarkCombo" and not (FindTool("god") and FindTool("dark") and (FindTool("dark blade") or FindTool("yoru")) and (FindTool("venom bow") or FindTool("serpent bow"))) then return end
   activeCombos[cName] = true
   task.spawn(function()
      for _, step in ipairs(seq) do
         if step.Weapon and step.Weapon ~= "None" then EquipWeapon(step.Weapon) task.wait(0.05) end
         if step.Skill then CastSkill(step.Skill, step.HoldTime or 0) end
         if step.DelayMs and step.DelayMs > 0 then task.wait(step.DelayMs / 1000) end
      end
      activeCombos[cName] = nil
   end)
end

local function GetMouseDirection()
   local char = LocalPlayer.Character
   local hrp = char and char:FindFirstChild("HumanoidRootPart")
   if not hrp then return Vector3.new(0, 0, 1) end
   local mouse = LocalPlayer:GetMouse()
   if mouse and mouse.Hit then
      local dir = (mouse.Hit.Position - hrp.Position)
      if dir.Magnitude > 0.001 then return dir.Unit end
   end
   return hrp.CFrame.LookVector
end

local function ApplyDashInDir(dir, fwd, dur)
   local char = LocalPlayer.Character
   local hrp = char and char:FindFirstChild("HumanoidRootPart")
   if not hrp then return end
   local vel = dir * (fwd or 350)
   
   local att = Instance.new("Attachment")
   att.Parent = hrp
   local lv = Instance.new("LinearVelocity")
   lv.Attachment0 = att
   lv.MaxForce = 1e6
   lv.VectorVelocity = vel
   lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
   lv.Parent = hrp

   task.delay(dur or 0.2, function() 
      if lv then lv:Destroy() end 
      if att then att:Destroy() end 
   end)
end

local function TriggerBug(tool, keyStr, isSpam, fwd, dur)
   local char = LocalPlayer.Character
   local hum = char and char:FindFirstChildOfClass("Humanoid")
   if hum and tool then
      hum:EquipTool(tool)
      local dir = GetMouseDirection()
      if keyStr then task.spawn(function() task.wait(0.05) CastSkill(keyStr, 0) end) end
      if isSpam then
         task.spawn(function()
            for _ = 1, 5 do ApplyDashInDir(dir, fwd or 350, dur) task.wait(0.2) end
         end)
      else
         ApplyDashInDir(dir, fwd, dur)
      end
   end
end

