local function CheckToolTip(tool, weaponType)
   local tooltip = tool.ToolTip
   return (weaponType == "Melee" and tooltip == "Melee") or
          (weaponType == "Blox Fruits" and (tooltip == "Blox Fruit" or string_find(tool.Name, "Fruit"))) or
          (weaponType == "Sword" and tooltip == "Sword") or
          (weaponType == "Gun" and tooltip == "Gun")
end

local function EquipWeapon(weaponType)
   local char = LocalPlayer.Character
   if not char then return nil, false end
   local humanoid = char:FindFirstChildOfClass("Humanoid")
   if not humanoid then return nil, false end

   local equipped = char:FindFirstChildOfClass("Tool")
   if equipped and CheckToolTip(equipped, weaponType) then
      return equipped, false
   end

   local backpack = LocalPlayer:FindFirstChild("Backpack")
   if backpack then
      for _, tool in ipairs(backpack:GetChildren()) do
         if tool:IsA("Tool") and CheckToolTip(tool, weaponType) then
            humanoid:EquipTool(tool)
            return tool, true
         end
      end
   end
   return char:FindFirstChildOfClass("Tool"), false
end

local function GetSpecialTool(keyword)
   local char = LocalPlayer.Character
   if not char then return nil end

   local equipped = char:FindFirstChildOfClass("Tool")
   if equipped and equipped.ToolTip == "Melee" and string_find(string_lower(equipped.Name), keyword) then
      return equipped
   end

   local backpack = LocalPlayer:FindFirstChild("Backpack")
   if backpack then
      for _, tool in ipairs(backpack:GetChildren()) do
         if tool:IsA("Tool") and tool.ToolTip == "Melee" and string_find(string_lower(tool.Name), keyword) then
            return tool
         end
      end
   end
   return nil
end

local function CastSkill(skillKey, holdDuration)
   ElevateThread()
   local keyStr = tostring(skillKey):upper()
   local keyEnum = Enum.KeyCode[keyStr]
   if keyEnum then
      VirtualInputManager:SendKeyEvent(true, keyEnum, false, game)
      if holdDuration and holdDuration > 0 then
         task.wait(holdDuration)
      else
         task.wait(0.01)
      end
      VirtualInputManager:SendKeyEvent(false, keyEnum, false, game)
   end
end

local function ApplyFastNoShake(enable)
   pcall(function()
      local util = ReplicatedStorage:FindFirstChild("Util")
      if not util then return end

      local targets = {
         util:FindFirstChild("CameraShake"),
         util:FindFirstChild("CameraShaker")
      }

      for _, moduleObj in ipairs(targets) do
         if moduleObj then
            local mainModule = moduleObj:IsA("ModuleScript") and moduleObj or moduleObj:FindFirstChild("Main") or moduleObj:FindFirstChild("CameraShake")
            if mainModule and mainModule:IsA("ModuleScript") then
               local loaded = require(mainModule)
               if type(loaded) == "table" then
                  if enable then
                     loaded.ShakeOnce = function() end
                     loaded.Shake = function() end
                     loaded.Start = function() end
                     loaded.ShakeSustained = function() end
                     if loaded.Frequency then loaded.Frequency = -1 end
                     if loaded.Scale then loaded.Scale = -1 end
                  end
               end
            end
         end
      end
   end)

   pcall(function()
      local remotes = ReplicatedStorage:FindFirstChild("Remotes")
      local changeSetting = remotes and remotes:FindFirstChild("ChangeSetting")
      if changeSetting then
         changeSetting:FireServer("CameraShake", not enable)
      end
   end)
end

local function ApplyNoMusic(enable)
   pcall(function()
      local global = require(ReplicatedStorage.Global)
      if global.updateMusic2 then
         global.updateMusic2(enable)
      end
   end)

   pcall(function()
      local events = ReplicatedStorage:FindFirstChild("Events")
      if events and events:FindFirstChild("ToggleMusic") then
         events.ToggleMusic:Fire(enable)
      end
   end)

   pcall(function()
      local worldOrigin = workspace:FindFirstChild("_WorldOrigin")
      if worldOrigin and worldOrigin:FindFirstChild("Sounds") then
         local locations = worldOrigin.Sounds:FindFirstChild("Locations")
         if locations then
            for _, sound in ipairs(locations:GetChildren()) do
               if sound:IsA("Sound") then
                  if enable then
                     sound:Pause()
                  else
                     sound:Resume()
                  end
               end
            end
         end
      end
   end)
end

local rawmetatable = getrawmetatable or function() return nil end
if rawmetatable and setreadonly then
   local mt = rawmetatable(game)
   local oldNamecall = mt.__namecall
   setreadonly(mt, false)
   mt.__namecall = newcclosure(function(self, ...)
      local method = getnamecallmethod()
      local args = {...}
      if method == "FireServer" and self.Name == "CommE" and args[1] == "Soru" then
         if UseSkillEnabled then
            task.spawn(function()
               ElevateThread()
               local tool, justEquipped = EquipWeapon(SelectedWeapon)
               if justEquipped or tool then
                  task.wait(0.05)
               end
               task.wait(SkillUseDelay / 1000)
               CastSkill(SelectedSkill, SkillHoldTime)
            end)
         end
      end
      return oldNamecall(self, ...)
   end)
   setreadonly(mt, true)
end

