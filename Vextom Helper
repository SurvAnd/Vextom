   Icon.BackgroundTransparency = 1
   Icon.Image = "rbxassetid://6031097225"
   Icon.ImageColor3 = Color3_fromRGB(150, 150, 150)
   Icon.Parent = Button

   local currentIndex = 1
   for i, opt in ipairs(options) do
      if opt == defaultOption then
         currentIndex = i
         break
