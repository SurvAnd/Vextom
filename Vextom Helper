UserInputService.InputBegan:Connect(function(input, gameProcessed)
   if gameProcessed then return end

   if input.UserInputType == Enum.UserInputType.Keyboard then
      if SuperJumpEnabled and input.KeyCode == SuperJumpKey then
         local char = LocalPlayer.Character
         local hrp = char and char:FindFirstChild("HumanoidRootPart")
         if hrp then
            hrp.AssemblyLinearVelocity = Vector3_new(hrp.AssemblyLinearVelocity.X, 350, hrp.AssemblyLinearVelocity.Z)
         end
      end

      if ZBugEnabled and input.KeyCode == ZBugKey then
         local tool = GetSpecialTool("sanguine") or GetSpecialTool("god")
         if tool then
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if humanoid and hrp then
               if humanoid.FloorMaterial ~= Enum.Material.Air then return end

               humanoid:EquipTool(tool)

               task.spawn(function()
                  task.wait(0.2)
                  ElevateThread()
                  CastSkill("Z", 0)
               end)

               task.spawn(function()
                  local bv = Instance_new("BodyVelocity")
                  bv.MaxForce = Vector3_new(1e8, 0, 1e8)
                  bv.Velocity = hrp.CFrame.LookVector * 500
                  bv.Parent = hrp

                  local duration = string_find(string_lower(tool.Name), "sanguine") and 4.5 or 4
                  local startTime = os_clock()
                  local conn
                  conn = RunService.RenderStepped:Connect(function()
                     if os_clock() - startTime < duration and hrp and hrp.Parent and humanoid.FloorMaterial == Enum.Material.Air then
                        humanoid.WalkSpeed = 500
                        bv.Velocity = hrp.CFrame.LookVector * 500
                     else
                        conn:Disconnect()
                        bv:Destroy()
                        humanoid.WalkSpeed = 16
                     end
                  end)
               end)
            end
         end
      end
   end
end)
